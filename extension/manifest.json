{
  "manifest_version": 3,
  "name": "Symbiote Companion",
  "version": "1.0",
  "description": "Bypasses e-commerce WAF protections by reading prices client-side and syncing them to your Symbiote dashboard.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "https://*.onrender.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
